# for C++
BasedOnStyle: LLVM
IndentWidth: 4
InsertBraces: true
MaxEmptyLinesToKeep: 1
KeepEmptyLines:
  # BasedOnStyle: LLVM では AtEndOfFile: false になる
  AtStartOfBlock: false
  # ファイル先頭に空行を入力している途中で自動保存されると、その空行が削除されて
  # 入力しにくくなるため、AtStartOfFile: false は設定しない
WrapNamespaceBodyWithEmptyLines: Never
RemoveEmptyLinesInUnwrappedLines: true
ReflowComments: false
AlignEscapedNewlines: Left
